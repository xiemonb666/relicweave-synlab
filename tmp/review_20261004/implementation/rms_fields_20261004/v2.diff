+def test_high_dynamic_range_rms_is_stable_and_unrepresentable_scale_is_unknown() -> None:
+    mask = np.array([True, True])
+    large = np.array([1e200, -1e200])
+    large_result = calibrate_rms_field(large, mask, 1e200)
+
+    assert large_result.status == "EXACT"
+    assert large_result.raw_rms_mm == 1e200
+    assert large_result.actual_rms_mm == 1e200
+
+    underflow_raw = np.array([1e100, -1e100])
+    underflow_original = underflow_raw.copy()
+    smallest_positive = np.nextafter(0.0, 1.0)
+    underflow_result = calibrate_rms_field(underflow_raw, mask, smallest_positive)
+
+    assert underflow_result.status == "UNKNOWN_SCALE_UNREPRESENTABLE"
+    assert underflow_result.scale_factor is None
+    assert underflow_result.actual_rms_mm == smallest_positive
+    assert underflow_result.actual_rms_mm > 0.0
+    assert underflow_result.to_metadata()["conditioned_exact_rms"] is False
+    np.testing.assert_array_equal(underflow_result.calibrated_field_mm,
+                                  [smallest_positive, -smallest_positive])
+    np.testing.assert_array_equal(underflow_result.raw_field_mm, underflow_original)
+    np.testing.assert_array_equal(underflow_raw, underflow_original)
+
+
