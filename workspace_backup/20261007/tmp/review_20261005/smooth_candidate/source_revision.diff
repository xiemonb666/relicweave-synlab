+def _interval_has_strict_interior_probe(lower: float, upper: float) -> bool:
+    """Require a finite interval wide enough to classify away from both hits."""
+    lower_value = float(lower)
+    upper_value = float(upper)
+    width = upper_value - lower_value
+    return (
+        math.isfinite(lower_value)
+        and math.isfinite(upper_value)
+        and math.isfinite(width)
+        and width > MIN_STRICT_INTERVAL_WIDTH_MM
+    )
 
 
