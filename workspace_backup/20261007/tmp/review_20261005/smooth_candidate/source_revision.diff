+def _audit_all_hit_distances(
+    raw_distances: Sequence[Any],
+    *,
+    max_distance_mm: float,
+    near_tolerance_mm: float = ALL_HIT_NEAR_TOL_MM,
+) -> dict[str, Any]:
+    """Retain raw OCC hits and refuse ambiguous near-distinct cuts.
+
+    Exact duplicate floating-point distances can be removed as duplicate face
+    reports. Distinct distances within the near tolerance are preserved in a
+    connected group and make the ray UNKNOWN; they are never averaged into a
+    replacement boundary.
+    """
+    maximum = float(max_distance_mm)
+    tolerance = float(near_tolerance_mm)
+    invalid_reasons: list[str] = []
+    if not math.isfinite(maximum) or maximum <= 0.0:
+        invalid_reasons.append("invalid_max_distance")
+    if not math.isfinite(tolerance) or tolerance <= 0.0:
+        invalid_reasons.append("invalid_near_tolerance")
+
+    raw_json: list[float | str | dict[str, str]] = []
+    finite_values: list[float] = []
+    for index, value in enumerate(raw_distances):
+        try:
+            distance = float(value)
+        except (TypeError, ValueError, OverflowError):
+            raw_json.append({"unparsed_value": repr(value)})
+            invalid_reasons.append(f"raw_hit_{index}_is_not_numeric")
+            continue
+        if math.isnan(distance):
+            raw_json.append("NaN")
+            invalid_reasons.append(f"raw_hit_{index}_is_nonfinite")
+            continue
+        if distance == math.inf:
+            raw_json.append("+Infinity")
+            invalid_reasons.append(f"raw_hit_{index}_is_nonfinite")
+            continue
+        if distance == -math.inf:
+            raw_json.append("-Infinity")
+            invalid_reasons.append(f"raw_hit_{index}_is_nonfinite")
+            continue
+        raw_json.append(distance)
+        finite_values.append(distance)
+        if distance < 0.0:
+            invalid_reasons.append(f"raw_hit_{index}_is_negative")
+        if math.isfinite(maximum) and distance > maximum:
+            invalid_reasons.append(f"raw_hit_{index}_is_beyond_query_limit")
+
+    ordered = sorted(finite_values)
+    exact_unique: list[float] = []
+    for distance in ordered:
+        if not exact_unique or distance != exact_unique[-1]:
+            exact_unique.append(distance)
+    exact_duplicate_count = len(finite_values) - len(exact_unique)
+
+    near_groups: list[list[float]] = []
+    if math.isfinite(tolerance) and tolerance > 0.0:
+        current_group: list[float] = []
+        for distance in exact_unique:
+            if not current_group or distance - current_group[-1] <= tolerance:
+                current_group.append(distance)
+            else:
+                if len(current_group) > 1:
+                    near_groups.append(current_group)
+                current_group = [distance]
+        if len(current_group) > 1:
+            near_groups.append(current_group)
+
+    near_hit_groups = [
+        {
+            "members_mm": [float(value) for value in group],
+            "span_mm": [float(group[0]), float(group[-1])],
+        }
+        for group in near_groups
+    ]
+    if near_groups:
+        invalid_reasons.append("distinct_hits_within_near_tolerance")
+    if invalid_reasons:
+        status = "UNKNOWN_RAW_HIT_OR_NEAR_HIT_AMBIGUITY"
+        usable_hits: list[float] | None = None
+    else:
+        status = "PASS_EXACT_DUPLICATES_ONLY"
+        usable_hits = [float(value) for value in exact_unique]
+
+    return {
+        "status": status,
+        "reason_codes": sorted(set(invalid_reasons)),
+        "raw_hit_values_mm": raw_json,
+        "raw_hit_count": len(raw_json),
+        "finite_raw_hit_count": len(finite_values),
+        "exact_duplicate_hit_count": exact_duplicate_count,
+        "exact_unique_finite_hits_mm": [float(value) for value in exact_unique],
+        "near_hit_tolerance_mm": tolerance,
+        "near_hit_groups": near_hit_groups,
+        "usable_hits_mm": usable_hits,
+        "cuts_use_group_mean": False,
+    }
+
