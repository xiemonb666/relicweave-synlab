    "# Normalize ignored copy operations only after copy rows, including any raw-source snapshots, are present.",
    "for e in entries:",
    "    if e.get(\"operation\")==\"copy_then_stage_exact\" and e.get(\"destination_ignore_status\")==\"ignored_exact_path_force_add_required\":",
    "        e[\"operation\"]=\"copy_then_stage_exact_force\"",
    "    op=e.get(\"operation\")",
    "    ignore=e.get(\"destination_ignore_status\")",
    "    if op in {\"copy_then_stage_exact\",\"copy_then_stage_exact_force\",\"stage_existing_exact\",\"stage_existing_exact_force\",\"destination_already_same_bytes_stage_exact\",\"already_recoverable_same_bytes_destination\"}:",
    "        if ignore not in {\"ignored_exact_path_force_add_required\",\"not_ignored_or_tracked\"}:",
    "            raise RuntimeError(\"action row is missing its exact destination ignore-status query\")",
    "        if ignore==\"ignored_exact_path_force_add_required\" and not op.endswith(\"_force\"):",
    "            raise RuntimeError(\"ignored destination lacks a pinned exact force-add operation\")",
    "        if op.endswith(\"_force\") and ignore!=\"ignored_exact_path_force_add_required\":",
    "            raise RuntimeError(\"force-add operation lacks a pinned ignored destination\")",
    "action_operations={\"stage_existing_exact\",\"stage_existing_exact_force\",\"copy_then_stage_exact\",\"copy_then_stage_exact_force\",\"destination_already_same_bytes_stage_exact\",\"blocked_source_pin_drift\",\"blocked_destination_collision\",\"blocked_source_unavailable\",\"blocked_destination_escape\"}"
