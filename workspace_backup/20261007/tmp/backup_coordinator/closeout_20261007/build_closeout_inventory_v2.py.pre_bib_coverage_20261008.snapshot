        e["destination_unique"]=True if e.get("operation") in {"already_on_branch","already_recoverable_same_bytes_destination"} else dest_counts.get(k)==1
        rp=REPOS[e["destination_repo"]].resolve();dp=(rp/Path(e["destination_repo_relative"])).resolve()
        try:dp.relative_to(rp);e["destination_within_repo"]=True
        except Exception:e["destination_within_repo"]=False;e["operation"]="blocked_destination_escape"

# Fresh source-pin and Git-state check at the end of the inventory pass.
post_hash_cache={}
for e in entries:
    src=e.get("source_absolute");expected=e.get("sha256")
    if not src or not expected:continue
    key=str(Path(src).resolve()).lower()
    if key not in post_hash_cache:
        try:post_hash_cache[key]=sha(Path(src))
        except Exception as ex:post_hash_cache[key]=("error",type(ex).__name__)
    post=post_hash_cache[key]
    if post[0]=="error":
        e["post_scan_source_check"]={"status":"unavailable","error_type":post[1]}
        if e.get("operation") not in {"already_on_branch","exclude"}:e["operation"]="blocked_source_unavailable"
    else:
        e["post_scan_source_check"]={"bytes":post[0],"sha256":post[1],"matches_inventory_pin":post[0]==e.get("bytes") and post[1]==expected}
        if post[0]!=e.get("bytes") or post[1]!=expected:
            e["post_scan_source_check"]["status"]="source_changed_during_inventory"
            if e.get("operation") not in {"already_on_branch","exclude"}:e["operation"]="blocked_source_pin_drift"
        else:e["post_scan_source_check"]["status"]="stable_through_inventory_pass"
for name,repo in REPOS.items():
    rc,b,_=git(repo,"branch","--show-current");branch=b.decode("utf-8","replace").strip() if rc==0 else None
    rc,h,_=git(repo,"rev-parse","HEAD");head=h.decode("ascii","replace").strip() if rc==0 else None
    rc,s,_=git(repo,"status","--porcelain=v1","--untracked-files=no");status=s.decode("utf-8","replace").splitlines() if rc==0 else ["status_error"]
    rc,st,_=git(repo,"diff","--cached","--name-only","-z");staged=zlist(st) if rc==0 else ["status_error"]
    rc,lr,_=git(repo,"ls-remote","--heads","origin",BRANCH,timeout=12);rhead=None
    if rc==0:
        for line in lr.decode("ascii","replace").splitlines():
            if line.endswith("\trefs/heads/"+BRANCH):rhead=line.split("\t",1)[0]
    repo_state[name]["final_snapshot"]={"branch":branch,"head":head,"remote_ls_remote_rc":rc,"remote_head":rhead,"remote_matches_head":bool(rhead and rhead==head),"tracked_status_lines":status,"staged_paths":staged,"tracked_index_clean":not status and not staged}
actions=[e for e in entries if e.get("operation") not in {"already_on_branch","already_recoverable_same_bytes_destination","exclude"} and e.get("destination_repo_relative")]
per_repo={}
for name in list(REPOS)+["workspace_root_external"]:
    rows=[e for e in actions if e.get("repo")==name]
    per_repo[name]={"action_count":len(rows),"action_bytes":sum(e.get("bytes") or 0 for e in rows),"copy_count":sum(e["operation"].startswith("copy") or e["operation"]=="destination_already_same_bytes_stage_exact" for e in rows),"direct_stage_count":sum(e["operation"].startswith("stage_existing") for e in rows),"classifications":{}}
    for e in rows:
        c=e.get("classification","unknown");per_repo[name]["classifications"][c]=per_repo[name]["classifications"].get(c,0)+1
large={ (x["repo"],x["path"]):x for x in large };large_list=sorted(large.values(),key=lambda x:(x["repo"],x["path"]))
excluded_total={k:v for k,v in sorted(excluded_counts.items())}
selected_presence={x:any(((e.get("source_workspace_relative") or ((e.get("repo","")+"/"+str(e.get("source_repo_relative",""))) if e.get("source_repo_relative") else "")).replace("\\","/")==x) for e in entries) for x in sorted(SELECTED)}
source_rows={}
for e in entries:
