 "summary":{"candidate_action_count":len(actions),"candidate_action_bytes":sum(e.get("bytes") or 0 for e in actions),"per_repo":per_repo,"destinations_unique":not any(v>1 for v in dest_counts.values()),"selected_npz_presence":selected_presence,"status_evidence_refs":len(status_evidence_closure),"status_evidence_refs_unmatched":sum(not x["current_inventory_match"] for x in status_evidence_closure),"status_evidence_refs_unmapped":sum(not x["recovery_mapping_complete"] for x in status_evidence_closure),"mutations_performed":False}
}
ip=OUT/"inventory.json";ip.write_text(json.dumps(inv,ensure_ascii=True,indent=2)+"\n",encoding="utf-8")
manifest["inventory_sha256"]=hashlib.sha256(ip.read_bytes()).hexdigest()
mp=OUT/"explicit_action_manifest.json";mp.write_text(json.dumps(manifest,ensure_ascii=True,indent=2)+"\n",encoding="utf-8")
# README is finalized and pinned before scanning; never rewrite it after inventory collection.
print(json.dumps({
 "out":str(OUT),"entries":len(entries),"actions":len(actions),"action_bytes":sum(e.get("bytes") or 0 for e in actions),
 "per_repo":per_repo,"large_files":len(large_list),"credential_paths_status_only":len(credential_paths),
