print("scanned root externals; entries",sum(e["repo"]=="workspace_root_external" for e in entries),flush=True)

# Handover documents keep their original root-relative mirror and also get a convenient
# byte-identical canonical copy inside the existing SynLab repository for single-repo restore.
for source_row in list(entries):
    wsrel=source_row.get("source_workspace_relative")
    if source_row.get("repo")!="workspace_root_external" or not wsrel:continue
    wsrel=wsrel.replace("\\","/")
    if wsrel!=CANONICAL_HANDOVER_SOURCE and not (wsrel.startswith(CANONICAL_HANDOVER_DIR+"/") and Path(wsrel).suffix.lower()==".docx"):continue
    canonical_rel="docs/handover/20261007/"+Path(wsrel).name
    canonical_path=REPOS["relicweave-synlab"]/Path(canonical_rel)
    if canonical_path.exists():
        try:cn,ch=sha(canonical_path)
        except Exception:cn,ch=None,None
        op="destination_already_same_bytes_stage_exact" if cn==source_row["bytes"] and ch==source_row["sha256"] else "blocked_destination_collision"
    else:op="copy_then_stage_exact"
    entries.append({"repo":"workspace_root_external","source_absolute":source_row["source_absolute"],"source_repo_relative":None,"source_workspace_relative":wsrel,"destination_repo":"relicweave-synlab","destination_repo_relative":canonical_rel,"operation":op,"classification":"canonical_handover_convenience_copy","git_status":"outside_repo","bytes":source_row["bytes"],"sha256":source_row["sha256"],"review_state":"root_exact_manifest_review_required","purpose":"byte-identical copy for single-SynLab checkout portability"})

# One batch path-only ignore/attribute query per destination repository.
for name,repo in REPOS.items():
    rows=[e for e in entries if e.get("destination_repo")==name and e.get("destination_repo_relative") and e.get("operation") not in {"already_on_branch","exclude","blocked_source_pin_drift","blocked_destination_collision"}]
    paths=sorted({e["destination_repo_relative"].replace("\\","/") for e in rows})
    if not paths:continue
    payload=b"\0".join(x.encode("utf-8","surrogateescape") for x in paths)+b"\0"
    rc,out,err=git(repo,"check-ignore","--stdin","-z",timeout=30,input_bytes=payload)
    if rc not in (0,1):raise RuntimeError(f"check-ignore failed closed for {name}: rc={rc}")
    ignored=set(zlist(out))
    if not ignored.issubset(set(paths)):raise RuntimeError(f"check-ignore returned an unrequested path for {name}")
    rc_attr,out_attr,err_attr=git(repo,"check-attr","--stdin","-z","text","eol","filter",timeout=30,input_bytes=payload)
    if rc_attr!=0:raise RuntimeError(f"check-attr failed closed for {name}: rc={rc_attr}")
    expected_attrs={"text","eol","filter"}
    fields=out_attr.split(b"\0")
    if fields and fields[-1]==b"":fields.pop()
    if len(fields)!=len(paths)*len(expected_attrs)*3:raise RuntimeError(f"check-attr returned incomplete output for {name}")
    attrmap={};seen=set()
    for i in range(0,len(fields),3):
        p=fields[i].decode("utf-8","surrogateescape");a=fields[i+1].decode("ascii","replace");v=fields[i+2].decode("utf-8","replace")
        key=(p,a)
        if p not in set(paths) or a not in expected_attrs or key in seen:raise RuntimeError(f"check-attr returned unexpected or duplicate data for {name}")
        seen.add(key);attrmap.setdefault(p,{})[a]=v
    expected_pairs={(p,a) for p in paths for a in expected_attrs}
    if seen!=expected_pairs or any(set(attrmap.get(p,{}))!=expected_attrs for p in paths):raise RuntimeError(f"check-attr results failed completeness validation for {name}")
    repo_state[name]["destination_git_attribute_query"]={"returncode":rc_attr,"paths_checked":len(paths),"attributes_per_path":sorted(expected_attrs),"complete":True}
    for e in rows:
        p=e["destination_repo_relative"].replace("\\","/")
        e["destination_ignore_status"]="ignored_exact_path_force_add_required" if p in ignored else "not_ignored_or_tracked"
        e["destination_git_attributes"]=attrmap.get(p,{})
        av=e["destination_git_attributes"]
        risk=av.get("text") in {"set","auto"} or av.get("eol") not in (None,"unspecified","unset") or av.get("filter") not in (None,"unspecified","unset")
        e["byte_preservation"]="explicit_text_or_filter_attribute_requires_raw_snapshot" if risk else "per-command_core.autocrlf=false_expected_for_new_paths"
        if risk and e["operation"]!="destination_already_same_bytes_stage_exact":
            raw_rel="docs/backup/20261007/raw_source/"
            raw_rel+=("workspace_external/" if e["repo"]=="workspace_root_external" else "")
            raw_rel+=str(e.get("source_workspace_relative") or e.get("source_repo_relative")).replace("\\","/")
            target=REPOS[name]/Path(raw_rel)
            if target.exists():
                try:tn,th=sha(target)
                except Exception:tn,th=None,None
                rop="destination_already_same_bytes_stage_exact" if tn==e["bytes"] and th==e["sha256"] else "blocked_destination_collision"
            else:rop="copy_then_stage_exact"
            entries.append({"repo":e["repo"],"source_absolute":e["source_absolute"],"source_repo_relative":e.get("source_repo_relative"),"source_workspace_relative":e.get("source_workspace_relative"),"destination_repo":name,"destination_repo_relative":raw_rel,"operation":rop,"classification":"exact_raw_source_snapshot_for_text_or_filter_attribute","git_status":e["git_status"],"bytes":e["bytes"],"sha256":e["sha256"],"review_state":"root_review_required_local_raw_archive","byte_preservation":"requires_local_docs_backup_raw_source_double_star_minus_text"})

