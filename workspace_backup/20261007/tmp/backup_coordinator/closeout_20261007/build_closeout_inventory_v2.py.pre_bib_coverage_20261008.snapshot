        e["operation"]="already_recoverable_same_bytes_destination"
action_operations={"stage_existing_exact","stage_existing_exact_force","copy_then_stage_exact","destination_already_same_bytes_stage_exact","blocked_source_pin_drift","blocked_destination_collision","blocked_source_unavailable","blocked_destination_escape"}
for e in entries:
    if e.get("operation") in action_operations and e.get("destination_repo") in REPOS and e.get("destination_repo_relative"):
        k=(e["destination_repo"],e["destination_repo_relative"].replace("\\","/").lower());dest_counts[k]=dest_counts.get(k,0)+1
for e in entries:
    if e.get("destination_repo") in REPOS and e.get("destination_repo_relative"):
