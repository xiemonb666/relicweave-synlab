 "closeout_master_docx":{"path":"RelicWeave_V1.47_A12_VesselForge_PGFrag_Closeout.docx","status":"FINAL_MASTER_FROZEN 786150B SHA883c831648d0697f456228f4d862deda8a36ff9740ecd6aadb3a3ebfdfdffc7d; rendered225pages; final visual QA authority tmp/v147_user_merge_20261007/LAYOUT_FINAL_QA_COVERAGE.json"},
