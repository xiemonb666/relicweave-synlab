    relevant=[e for e in raw_snapshot_map if e.get("destination_repo")==name and str(e.get("destination_path","")).startswith("docs/backup/20261007/raw_source/")]
    attr_proposals[name]={"current_gitattributes":{"bytes":state["gitattributes"]["bytes"],"sha256":state["gitattributes"]["sha256"]},"required_raw_snapshot_rule":rule.decode("ascii"),"required_rule_present":rule_present,"prechange_workspace_snapshot":{"path":str(original_path),"bytes":original_bytes,"sha256":original_sha},"affected_raw_snapshot_count":len(relevant),"change_authorized_by_root_for_prep":True,"changed_in_prep":True}

dest_counts={}
# If a closed review artifact was already copied into docs/reviews under identical bytes,
# preserve the original source path as an alias to that existing canonical destination.
for e in entries:
    if e.get("operation")!="destination_already_same_bytes_stage_exact":continue
    target_repo=e.get("destination_repo");target_rel=str(e.get("destination_repo_relative","")).replace("\\","/")
    canonical=next((x for x in entries if x is not e and x.get("repo")==target_repo and x.get("source_repo_relative")==target_rel and x.get("sha256")==e.get("sha256") and x.get("bytes")==e.get("bytes")),None)
    if canonical:
