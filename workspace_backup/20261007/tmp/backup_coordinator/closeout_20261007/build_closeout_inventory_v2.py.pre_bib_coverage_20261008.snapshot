def git(repo,*args,timeout=20,input_bytes=None):
    try:
        p=subprocess.run([str(GIT_EXE),"-C",str(repo),*args],input=input_bytes,stdout=subprocess.PIPE,stderr=subprocess.PIPE,timeout=timeout,check=False)
        return p.returncode,p.stdout,p.stderr
    except subprocess.TimeoutExpired as e:return 124,e.stdout or b"",e.stderr or b""
def zlist(b):return [x.decode("utf-8","surrogateescape") for x in b.split(b"\0") if x]
def sha(p):
    h=hashlib.sha256();n=0
    with p.open("rb") as f:
        for b in iter(lambda:f.read(1024*1024),b""):n+=len(b);h.update(b)
    return n,h.hexdigest()
def blob_oid(b):
    h=hashlib.sha1();h.update(b"blob "+str(len(b)).encode()+b"\0");h.update(b);return h.hexdigest()
def under(p,roots):
    q=p.replace("\\","/").lower()
    return any(q==r.lower() or q.startswith(r.lower().rstrip("/")+"/") for r in roots)
def snapshot(n):
    n=n.lower()
    return any("."+x+"." in n for x in ("py","pyi","jl","js","mjs","ts","tsx","rs","c","h","cpp","hpp","sh","ps1","md","json","toml"))
def secret_path(p):
    base=p.replace("\\","/").rsplit("/",1)[-1].lower()
    return bool(SECRET_RE.search("/"+p.replace("\\","/")+"/")) or base in {".netrc",".pypirc","service-account.json","credentials.json"}
def is_generated(p):
    parts=p.replace("\\","/").lower().split("/")
    return any(x in parts for x in ("generated_data","generated-datasets","report_exports","a12_exports","pytest-tmp","pytest_tmp","outputs","output","large_results"))
def under_backup_coordinator(p):
    parts=p.replace("\\","/").lower().split("/")
    return any(parts[i:i+2]==["tmp","backup_coordinator"] for i in range(max(0,len(parts)-1)))
def backup_coordinator_record_class(p,size):
    q=p.replace("\\","/"); norm=q.lower(); base=Path(q).name.lower(); ext=Path(base).suffix.lower()
    if not under_backup_coordinator(q):return None
    if base in BACKUP_COORDINATOR_DYNAMIC_NAMES or base.endswith((".writing",".partial")):return None
    if any(part in {"execution_receipt_gitlogs","execution_gitlogs","mutation_gitlogs"} for part in norm.split("/")):return None
    if size>BACKUP_COORDINATOR_MAX_BYTES or is_generated(q):return None
    if ext not in BACKUP_COORDINATOR_SUFFIXES and base not in NAMES and not base.startswith(LICENSE_PREFIXES):return None
    if ext in {".toml",".yaml",".yml"}:return "project_configuration"
    if ext==".md":return "authored_documentation"
    if ext in BACKUP_COORDINATOR_SUFFIXES or base in NAMES or base.startswith(LICENSE_PREFIXES):return "backup_handoff_plan_or_receipt"
    return None
def classify(p,size,repo_rel=None):
    q=p.replace("\\","/"); parts=q.lower().split("/"); base=parts[-1]; ext=Path(base).suffix.lower()
    if ext in CODE or snapshot(base):return "source_code_or_original_snapshot",True
    if base in NAMES or base.startswith(LICENSE_PREFIXES):return "source_config_or_license",True
    coordinator_class=backup_coordinator_record_class(q,size)
    if coordinator_class:return coordinator_class,True
    if repo_rel and repo_rel.replace("\\","/").lower().startswith("tmp/backup_coordinator/"):return "internal_backup_tooling_noncode",False
    if ext==".docx":
        if len(parts)==1 and base in {x.lower() for x in ROOT_DOCX}:return "root_reference_docx",True
        if any(t in base for t in ("v1.47","handoff","master")):return "root_closeout_docx_pending_qa",False
        if "v1.46" in base:return "root_closeout_reference_docx",True
        return "renderer_or_other_docx",False
    if ext in DOCS:return ("closed_review_documentation",True) if under(q,CLOSED) else (("generated_report_document",False) if is_generated(q) else ("authored_documentation",True))
    if ext in {".log",".raw",".out",".stdout",".stderr"}:
        return ("closed_review_raw_execution_record",True) if under(q,CLOSED) and size<=10*1024*1024 else ("runtime_text_output",False)
    if ext==".xml" and q in SELECTED_XML:return "closed_review_junit_or_xml_record",True
    if ext==".xml" and under(q,CLOSED) and size<=10*1024*1024:return "closed_review_junit_or_xml_record",True
    if ext in CONFIG:
        if any(x in parts for x in ("config","configs","schema","schemas","fixtures","tests","examples")):return "project_configuration_or_fixture",True
        if ext in {".yaml",".yml"} and any(x in parts for x in ("data","metadata","report")) and not any(x in parts for x in ("config","configs","schema","schemas","fixtures","tests")):return "generated_metadata_yaml",False
        if is_generated(q):return "generated_configlike_output",False
        if any(x in parts for x in ("config","configs","schema","schemas",".github","fixtures","tests","examples")) or len(parts)<=2:return "project_configuration",True
        return "unclassified_yaml_or_config",False
    if ext==".json":
        if under(q,CLOSED):return "closed_review_record",True
        if any(x in parts for x in ("tests","fixtures","schemas","configs",".github","examples")):return "fixture_or_configuration_json",True
        if is_generated(q):return "generated_json_report_or_dataset",False
        if any(k in base for k in ("source_pin","source_freeze","manifest","case","schema","contract","design","readme","lock","index","fixture","config","policy","readiness","acceptance","receipt")):return "source_metadata_json",True
        return "unclassified_json_output",False
    if ext==".jsonl":return ("source_fixture_jsonl",True) if any(x in parts for x in ("tests","fixtures","schemas","configs")) else ("generated_jsonl_dataset",False)
    if ext in {".csv",".tsv",".npy",".npz",".parquet",".arrow",".feather",".h5",".hdf5",".mat"}:
        if q in SELECTED or q in TRACKED_REPLAY:return "selected_bounded_replay_data",True
        if under(q,CLOSED) and ext in {".csv",".tsv"} and size<=10*1024*1024:return "closed_review_numeric_evidence",True
        if any(x in parts for x in ("tests","fixtures","schemas")) and size<=20*1024*1024:return "small_source_test_fixture",True
        return "generated_numeric_dataset",False
    if ext in {".png",".jpg",".jpeg",".webp",".gif",".bmp",".tif",".tiff"}:
        return ("closed_review_figure",True) if under(q,CLOSED) and ext==".png" and size<=5*1024*1024 else ("image_or_unreviewed_figure",False)
    if ext==".txt":
        if under(q,CLOSED):return "closed_review_text_record",True
        if base.endswith(".log") or base.startswith(("stdout","stderr","pytest","run_")):return "runtime_text_output",False
        if under(q,CLOSED):return "closed_review_record",True
        if any(x in parts for x in ("docs","experiments","examples","tests","schemas","src","synlab","tools","scripts")):return "text_document_or_dependency",True
        return "unclassified_text_output",False
    return "not_in_source_scope",False

def load_v1():
    p=ROOT/"tmp"/"backup_coordinator"/"new_milestone_closed_backup_plan_20261007.json"
    if not p.exists():return [],None
    try:
        d=json.loads(p.read_text(encoding="utf-8"))
        return d.get("files",[]),sha(p)[1]
    except Exception as e:return [],"read_error:"+type(e).__name__

v1_files,v1_sha=load_v1()
v1_by_source={}
for old in v1_files:
    src=old.get("source_absolute")
    if src:v1_by_source[str(Path(src).resolve()).lower()]=old

repo_state={}; repo_data={}
for name,repo in REPOS.items():
    def g(*args,timeout=20,input_bytes=None):return git(repo,*args,timeout=timeout,input_bytes=input_bytes)
    rc,x,_=g("rev-parse","--show-toplevel");top=x.decode("utf-8","replace").strip() if rc==0 else None
    rc,x,_=g("branch","--show-current");branch=x.decode("utf-8","replace").strip() if rc==0 else None
    rc,x,_=g("rev-parse","HEAD");head=x.decode("ascii","replace").strip() if rc==0 else None
    rc,x,_=g("rev-parse","HEAD^");parent=x.decode("ascii","replace").strip() if rc==0 else None
    rc,x,_=g("ls-files","-z");tracked=set(zlist(x)) if rc==0 else set()
    rc,x,_=g("ls-files","--others","--exclude-standard","-z");untracked=set(zlist(x)) if rc==0 else set()
    rc,x,_=g("ls-files","--others","--ignored","--exclude-standard","-z");ignored=set(zlist(x)) if rc==0 else set()
    rc,x,_=g("status","--porcelain=v1","--untracked-files=no");tracked_status=x.decode("utf-8","replace").splitlines() if rc==0 else ["status_error"]
    modified=set()
    for line in tracked_status:
        if len(line)>=4:modified.add(line[3:].replace("\\","/"))
    rc,x,_=g("diff","--cached","--name-only","-z");staged=zlist(x) if rc==0 else ["status_error"]
    rc,x,_=g("remote","get-url","origin");remote=x.decode("utf-8","replace").strip() if rc==0 else None
    if remote and "://" in remote and "@" in remote.split("://",1)[1]:remote=remote.split("://",1)[0]+"://[redacted]@"+remote.split("://",1)[1].split("@",1)[1]
    lr_rc,lr,_=g("ls-remote","--heads","origin",BRANCH,timeout=12);remote_head=None
    if lr_rc==0:
        for line in lr.decode("ascii","replace").splitlines():
            if line.endswith("\trefs/heads/"+BRANCH):remote_head=line.split("\t",1)[0]
    rc,x,_=g("ls-files","--stage","-z");index={}
    if rc==0:
        for item in x.split(b"\0"):
            if not item:continue
            meta,path=item.split(b"\t",1);fields=meta.decode("ascii","replace").split()
            if len(fields)>=3:index[path.decode("utf-8","surrogateescape")]=fields[1]
    rc,x,_=g("ls-tree","-r","-z","--full-tree","HEAD");head_blobs={}
    if rc==0:
        for item in x.split(b"\0"):
            if not item:continue
            meta,path=item.split(b"\t",1);fields=meta.decode("ascii","replace").split()
            if len(fields)>=3:head_blobs[path.decode("utf-8","surrogateescape")]=fields[2]
    rc,x,_=g("config","--get","core.autocrlf");auto=x.decode("utf-8","replace").strip() if rc==0 else "unset"
    ap=repo/".gitattributes";an,ah=sha(ap) if ap.exists() else (None,None)
    repo_state[name]={"repo_root":str(repo),"git_toplevel":top,"branch":branch,"head":head,"parent":parent,"expected_branch":BRANCH,"branch_matches":branch==BRANCH,"origin_sanitized":remote,"remote_ls_remote_rc":lr_rc,"remote_head":remote_head,"remote_matches_head":bool(remote_head and remote_head==head),"core_autocrlf_current_config":auto,"tracked_count":len(tracked),"untracked_nonignored_count":len(untracked),"ignored_untracked_count":len(ignored),"tracked_status_lines":tracked_status,"staged_paths":staged,"tracked_index_clean":not tracked_status and not staged,"gitattributes":{"bytes":an,"sha256":ah}}
    repo_data[name]={"tracked":tracked,"untracked":untracked,"ignored":ignored,"index":index,"head_blobs":head_blobs,"modified":modified}
    print("preflight",name,"tracked",len(tracked),"untracked",len(untracked),"ignored",len(ignored),"head",head,"remote",remote_head,flush=True)

entries=[];large=[];credential_paths=[];skipped=[];excluded_counts={};errors=[]
README_PATH=OUT/"README.md"
README_PRE_SCAN=sha(README_PATH)
def add_excluded(name,rel,size,cls,status,path):
    excluded_counts[cls]=excluded_counts.get(cls,0)+1
    if size>50*1024*1024:large.append({"repo":name,"path":rel,"bytes":size,"flag":"over_50MiB","classification":cls})
    if size>50*1024*1024 or cls in {"generated_metadata_yaml","generated_numeric_dataset","generated_json_report_or_dataset","renderer_or_other_docx"}:
        entries.append({"repo":name,"source_absolute":str(path),"source_repo_relative":rel if name in REPOS else None,"source_workspace_relative":rel if name=="workspace_root_external" else None,"destination_repo":None,"destination_repo_relative":None,"operation":"exclude","classification":cls,"git_status":status,"bytes":size,"sha256":None,"review_state":"excluded"})

def make_entry(path,name,rel,wsrel,size,digest,status,cls):
    legacy=v1_by_source.get(str(path.resolve()).lower())
    dest_repo=name if name in REPOS else "relicweave-synlab"
    dest_rel=rel
    op="already_on_branch" if status=="tracked" else ("stage_existing_exact_force" if status=="ignored_untracked" else "stage_existing_exact")
    legacy_pin=None
    if legacy:
        dest_repo=legacy.get("repo",dest_repo);dest_rel=legacy.get("destination_repo_relative",rel)
        legacy_pin={"bytes":legacy.get("bytes"),"sha256":legacy.get("sha256"),"prior_operation":legacy.get("operation")}
        if legacy_pin["bytes"]!=size or legacy_pin["sha256"]!=digest:op="blocked_source_pin_drift"
        elif dest_rel!=rel or legacy.get("operation")=="copy_exact":op="copy_then_stage_exact"
        elif status!="tracked":op="stage_existing_exact_force" if status=="ignored_untracked" else "stage_existing_exact"
    elif name=="workspace_root_external":
        dest_rel="workspace_backup/20261007/"+wsrel;op="copy_then_stage_exact"
    elif under(wsrel,CLOSED):
        match=next((r for r in CLOSED if wsrel.lower()==r.lower() or wsrel.lower().startswith(r.lower()+"/")),None)
        tail=wsrel[len(match):].lstrip("/") if match else path.name
        group=match.split("/")[-1] if match else "closed_review"
        dest_rel="docs/reviews/20261007/"+group+"/"+tail;op="copy_then_stage_exact"
    # Existing destination only counts as reusable when exact bytes match.
    dr=REPOS.get(dest_repo)
    if dr and dest_rel and op not in {"blocked_source_pin_drift"} and not (name==dest_repo and (dr/Path(dest_rel)).resolve()==path.resolve()):
        dp=dr/Path(dest_rel)
        if dp.exists():
            try:dn,dh=sha(dp)
            except Exception:dn,dh=None,None
            if dn==size and dh==digest:op="destination_already_same_bytes_stage_exact"
            else:op="blocked_destination_collision"
    row={"repo":name,"source_absolute":str(path),"source_repo_relative":rel if name in REPOS else None,"source_workspace_relative":wsrel if name=="workspace_root_external" else None,"destination_repo":dest_repo,"destination_repo_relative":dest_rel,"operation":op,"classification":cls,"git_status":status,"bytes":size,"sha256":digest,"legacy_v1_pin":legacy_pin,"review_state":"root_exact_manifest_review_required"}
    # Compare worktree bytes to the current index/HEAD blob without printing source contents.
    if name in REPOS and status in {"tracked","tracked_modified"}:
        oid=repo_data[name]["head_blobs"].get(rel);row["git_head_blob_oid"]=oid
        try:
            data=path.read_bytes();raw=blob_oid(data)
            if raw==oid:relation="raw_worktree_matches_head_blob"
            elif blob_oid(data.replace(b"\r\n",b"\n"))==oid:relation="crlf_lf_normalization_only"
            else:relation="other_filter_or_content_relation_unresolved"
        except Exception as e:relation="read_error:"+type(e).__name__
        row["worktree_raw_git_blob_oid"]=raw if "raw" in locals() else None
        row["worktree_head_relation"]=relation
        if oid:
            rc,x,_=git(REPOS[name],"cat-file","-s",oid,timeout=20)
            try:row["git_head_blob_bytes"]=int(x.decode("ascii").strip()) if rc==0 else None
            except Exception:row["git_head_blob_bytes"]=None
        if relation!="raw_worktree_matches_head_blob":
            raw_dest="docs/backup/20261007/raw_source/"+rel
            raw_target=REPOS[name]/Path(raw_dest)
            if raw_target.exists():
                try:rn,rh=sha(raw_target)
                except Exception:rn,rh=None,None
                rop="destination_already_same_bytes_stage_exact" if rn==size and rh==digest else "blocked_destination_collision"
            else:rop="copy_then_stage_exact"
            entries.append({"repo":name,"source_absolute":str(path),"source_repo_relative":rel,"destination_repo":name,"destination_repo_relative":raw_dest,"operation":rop,"classification":"exact_raw_worktree_snapshot_for_head_normalization_review","git_status":status,"bytes":size,"sha256":digest,"git_head_blob_oid":oid,"worktree_raw_git_blob_oid":raw if "raw" in locals() else None,"worktree_head_relation":relation,"review_state":"root_review_required_local_raw_archive"})
    return row

repo_abs={p.resolve() for p in REPOS.values()}
def walk_files(start,repo_name=None):
    for d,dirs,files in os.walk(start,topdown=True,followlinks=False):
        base=Path(d); kept=[]
        for dn in dirs:
            child=(Path(base.relative_to(start).as_posix())/dn).as_posix()
            if dn.lower() in SKIP:
                skipped.append({"repo":repo_name or "workspace_root_external","path":child,"reason":"environment_build_or_cache"});continue
            if repo_name=="relicweave-synlab" and child.replace("\\","/").lower() in RUNTIMES:
                skipped.append({"repo":repo_name,"path":child,"reason":"vendored_runtime_or_installer"});continue
            if repo_name is None:
                if (base/dn).resolve() in repo_abs:continue
                if any(child.replace("\\","/").lower()==r or child.replace("\\","/").lower().startswith(r+"/") for r in RUNTIMES):
                    skipped.append({"repo":"workspace_root_external","path":child,"reason":"vendored_runtime_or_installer"});continue
            kept.append(dn)
        dirs[:]=kept
        for fn in files:
            p=base/fn
            try:rel=p.relative_to(start).as_posix();size=p.stat().st_size
            except Exception as e:errors.append({"repo":repo_name or "workspace_root_external","path":str(p),"error_type":type(e).__name__});continue
            if p.is_symlink():continue
            if size>50*1024*1024:large.append({"repo":repo_name or "workspace_root_external","path":rel,"bytes":size,"flag":"over_50MiB","classification":"size_only_no_hash"})
            wsrel=(repo_name+"/"+rel) if repo_name else rel
            wsrel_norm=wsrel.replace("\\","/")
            status="outside_repo"
            if repo_name:
                sets=repo_data[repo_name]
                status=("tracked_modified" if rel in sets["modified"] else "tracked") if rel in sets["tracked"] else ("ignored_untracked" if rel in sets["ignored"] else "untracked")
            if secret_path(rel):
                credential_paths.append({"repo":repo_name or "workspace_root_external","path":rel,"status":"credential_or_private_key_name","bytes":size})
                add_excluded(repo_name or "workspace_root_external",rel,size,"credential_path_excluded",status,p);continue
            if wsrel_norm in POST_SCAN_EXPORTS:
                add_excluded("workspace_root_external",rel,size,"post_inventory_supplementary_export_not_in_main_manifest",status,p);continue
            if repo_name=="relicweave-synlab" and rel.replace("\\","/") in POST_PUSH_SIDECARS:
                add_excluded(repo_name,rel,size,"post_push_delivery_sidecar_outside_its_own_commit_set",status,p);continue
            # Keep all authored helper code/snapshots. Preserve bounded stable plans,
            # receipts, evidence, and configs at their original workspace paths, while
            # excluding self-referential inventory exports and transient mutation logs.
            coordinator_class=backup_coordinator_record_class(wsrel_norm,size)
            coordinator_noncode=under_backup_coordinator(wsrel_norm) and Path(fn).suffix.lower() not in CODE and not snapshot(fn)
            if coordinator_noncode and coordinator_class is None:
                add_excluded(repo_name or "workspace_root_external",rel,size,"internal_backup_record_dynamic_or_out_of_scope",status,p);continue
            v1=v1_by_source.get(str(p.resolve()).lower())
            if size>50*1024*1024:
                add_excluded(repo_name or "workspace_root_external",rel,size,"source_over_50MiB_requires_review",status,p);continue
            cls,include=classify(wsrel,size,rel if repo_name else None)
            if repo_name is None and wsrel_norm.startswith(CANONICAL_HANDOVER_DIR+"/") and Path(fn).suffix.lower()==".docx":
                cls,include="final_handoff_docx_pending_qa_or_frozen",True
            if wsrel.replace("\\","/") in EXACT_ROOT_DOCS:
                cls,include="root_accepted_progress_or_readiness_artifact",True
            if wsrel_norm in PIN_EVIDENCE:
                cls,include="pinned_status_evidence_dependency",True
            if wsrel_norm in SCIENCE98_COORDINATOR_FILES:
                cls,include="accepted_science98_backup_record_or_tool",True
            if wsrel_norm in ATTRIBUTE_SNAPSHOT_FILES:
                cls,include="prechange_gitattributes_byte_snapshot",True
            if repo_name is None and wsrel_norm in FINAL_HANDOVER_MD_PINS:
                cls,include="root_final_handover_markdown_frozen_pin",True
            if repo_name is None and wsrel_norm in FINAL_ROOT_DOCX_PINS:
                cls,include="root_final_closeout_docx_frozen_pin",True
            if coordinator_class:
                cls,include=coordinator_class,True
            if v1:
                cls="preserved_prior_v1_candidate";include=True
            if not include:
                if cls in {"generated_metadata_yaml","generated_numeric_dataset","generated_json_report_or_dataset","renderer_or_other_docx"}:add_excluded(repo_name or "workspace_root_external",rel,size,cls,status,p)
                continue
            try:n,dig=sha(p)
            except Exception as e:errors.append({"repo":repo_name or "workspace_root_external","path":rel,"error_type":type(e).__name__});continue
            if repo_name is None and wsrel_norm in FINAL_ROOT_DOCX_PINS:
                expected_docx=FINAL_ROOT_DOCX_PINS[wsrel_norm]
                if n!=expected_docx.get("bytes") or dig!=expected_docx.get("sha256"):
                    errors.append({"repo":"workspace_root_external","path":rel,"error_type":"final_docx_pin_mismatch"})
                    continue
            if repo_name is None and wsrel_norm in FINAL_HANDOVER_MD_PINS:
                expected_handover=FINAL_HANDOVER_MD_PINS[wsrel_norm]
                if n!=expected_handover.get("bytes") or dig!=expected_handover.get("sha256"):
                    errors.append({"repo":"workspace_root_external","path":rel,"error_type":"final_handover_md_pin_mismatch"})
                    continue
            entries.append(make_entry(p,repo_name or "workspace_root_external",rel,wsrel,n,dig,status,cls))

for name,repo in REPOS.items():
    walk_files(repo,name)
    print("scanned repo",name,"entries",sum(e["repo"]==name for e in entries),flush=True)
