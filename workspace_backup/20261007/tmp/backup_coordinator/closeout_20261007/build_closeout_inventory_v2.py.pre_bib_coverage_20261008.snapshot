status_evidence_closure=[]
for ref in STATUS_PINS.get("evidence_files",[]):
    source_path=str(ref.get("path","")).replace("\\","/")
    repo_name,sep,repo_rel=source_path.partition("/")
    expected_bytes=ref.get("bytes");expected_sha=ref.get("sha256")
    if repo_name in REPOS:
        candidate_rows=source_rows.get((repo_name,repo_rel),[])
    else:
        candidate_rows=[e for e in entries if e.get("repo")=="workspace_root_external" and (e.get("source_workspace_relative") or "").replace("\\","/")==source_path]
    primary=next((e for e in candidate_rows if not str(e.get("classification","")).startswith("exact_raw_")),None)
    raw_rows=[e for e in candidate_rows if str(e.get("classification","")).startswith("exact_raw_") and e.get("sha256")==expected_sha and e.get("bytes")==expected_bytes]
    current_match=bool(primary and primary.get("sha256")==expected_sha and primary.get("bytes")==expected_bytes)
    recovery=None
    if current_match and primary.get("operation")=="already_on_branch" and primary.get("worktree_head_relation")=="raw_worktree_matches_head_blob":
        recovery={"kind":"same_original_path_already_in_head_byte_identical","repo":repo_name,"path":repo_rel,"head_blob_oid":primary.get("git_head_blob_oid")}
    elif current_match and raw_rows:
        raw=raw_rows[0]
        recovery={"kind":"exact_raw_snapshot_candidate_for_head_normalization_or_attribute","repo":raw.get("destination_repo"),"path":raw.get("destination_repo_relative"),"operation":raw.get("operation"),"sha256":raw.get("sha256"),"bytes":raw.get("bytes")}
    elif current_match and primary and primary.get("destination_repo") and primary.get("destination_repo_relative"):
        recovery={"kind":"same_path_or_copied_exact_candidate","repo":primary.get("destination_repo"),"path":primary.get("destination_repo_relative"),"operation":primary.get("operation"),"sha256":primary.get("sha256"),"bytes":primary.get("bytes")}
    status_evidence_closure.append({
      "source_path":source_path,"expected_bytes":expected_bytes,"expected_sha256":expected_sha,
      "current_inventory_match":current_match,"current_bytes":primary.get("bytes") if primary else None,
      "current_sha256":primary.get("sha256") if primary else None,
      "backup_recovery_mapping":recovery,
      "recovery_mapping_complete":bool(recovery)
    })
pins_bytes,pins_sha=sha(PINS_PATH) if PINS_PATH.exists() else (None,None)
pins_self={"path":"pgfrag/tmp/review_20261006/20261006_physics_core_review_addendum.pins.json","bytes":pins_bytes,"sha256":pins_sha,"evidence_refs":len(status_evidence_closure),"all_current_refs_match":all(x["current_inventory_match"] for x in status_evidence_closure),"all_refs_have_recovery_mapping":all(x["recovery_mapping_complete"] for x in status_evidence_closure)}
tooling_provenance={}
if not GIT_EXE.is_file():raise RuntimeError(f"bundled Git executable missing: {GIT_EXE}")
git_binary_bytes,git_binary_sha=sha(GIT_EXE)
tooling_provenance["git.exe"]={"path":str(GIT_EXE),"bytes":git_binary_bytes,"sha256":git_binary_sha}
for tool_name in ("build_closeout_inventory_v2.py","verify_manifest_readonly.py","export_frozen_maps.py","execute_closeout_backup.py","independent_postverify_all_code_backup_20261007.py"):
    tool_path=OUT/tool_name
    try:tn,th=sha(tool_path);tooling_provenance[tool_name]={"path":str(tool_path),"bytes":tn,"sha256":th}
    except Exception as ex:tooling_provenance[tool_name]={"path":str(tool_path),"error_type":type(ex).__name__}
readme_after_scan=sha(README_PATH)
readme_entry=next((e for e in entries if e.get("source_absolute")==str(README_PATH)),None)
if readme_after_scan!=README_PRE_SCAN or readme_entry is None or (readme_entry.get("bytes"),readme_entry.get("sha256"))!=README_PRE_SCAN:
 errors.append({"scope":"readme_inventory_pin","path":str(README_PATH),"error":"README was not inventoried with its exact pre-scan bytes"})
inv={
 "schema":"codex_full_source_backup_inventory_v2",
 "mode":"PREPARE_ONLY_NO_COPY_NO_GIT_MUTATION",
 "created_utc":datetime.now(timezone.utc).isoformat(),
 "workspace_root":str(ROOT),
 "scope":"All source/code-bearing files including arbitrary code suffix snapshots, tests/fixtures, project configuration/dependency locks, authored docs/licenses, reviewed small evidence, and root-external authored source across three existing repos. External files map into SynLab workspace_backup preserving original root-relative paths. No fourth repo.",
 "repositories":repo_state,
 "legacy_v1":{"path":str(ROOT/"tmp"/"backup_coordinator"/"new_milestone_closed_backup_plan_20261007.json"),"sha256":v1_sha,"items":len(v1_files),"reconciliation":v1_reconcile},
 "summary":{
  "inventory_entries":len(entries),"action_count":len(actions),"action_bytes":sum(e.get("bytes") or 0 for e in actions),
  "per_repo":per_repo,"large_files_over_50MiB_count":len(large_list),"credential_path_status_only_count":len(credential_paths),
  "excluded_subtrees_count":len(skipped),"excluded_classification_counts":excluded_total,"scan_errors_count":len(errors),
  "destination_collisions_count":sum(1 for v in dest_counts.values() if v>1),
  "status_evidence_refs":len(status_evidence_closure),
  "status_evidence_refs_unmatched":sum(not x["current_inventory_match"] for x in status_evidence_closure),
  "status_evidence_refs_unmapped":sum(not x["recovery_mapping_complete"] for x in status_evidence_closure),
  "tracked_raw_matches_head":sum(e.get("worktree_head_relation")=="raw_worktree_matches_head_blob" for e in unique_tracked_rows),
  "tracked_crlf_only_normalized":sum(e.get("worktree_head_relation")=="crlf_lf_normalization_only" for e in unique_tracked_rows),
  "tracked_other_or_unresolved":sum(e.get("worktree_head_relation")=="other_filter_or_content_relation_unresolved" for e in unique_tracked_rows),
  "selected_npz_presence":selected_presence
 },
 "large_files_over_50MiB":large_list,
 "status_pins_manifest":pins_self,
 "status_evidence_dependency_closure":status_evidence_closure,
 "inventory_tooling_provenance":tooling_provenance,
 "git_executable":{"path":str(GIT_EXE),"bytes":git_binary_bytes,"sha256":git_binary_sha},
 "tracked_raw_source_snapshot_map":raw_snapshot_map,
 "credential_path_status_only":credential_paths,
 "excluded_subtrees":skipped,
 "excluded_classification_counts":excluded_total,
 "scan_errors":errors,
 "pending_documents":pending_docs,
 "root_docx_candidates":root_docx,
 "byte_preservation_attribute_proposals":attr_proposals,
 "entries":entries,
 "notes":[
  "Tracked paths carry working-tree SHA-256/bytes and HEAD blob OID/bytes; clean tracked status is not treated as proof of raw byte identity.",
  "Tracked worktree bytes differing only by CRLF/LF normalization are proposed as exact raw snapshots under docs/backup/20261007/raw_source/<repo-relative-path>; no original tracked HEAD is rewritten.",
  "Explicit text/eol/filter attributes are batch-queried; affected new paths get a raw snapshot proposal. No .gitattributes mutation was made.",
  "Selected three bounded replay NPZ paths and exactly two portable JUnit fixture XML paths must be present or demonstrably byte-identical to tracked copies; all other generated numeric datasets and non-CLOSED XML remain excluded.",
   "Authored scripts, README, and small handoff plans/receipts under tmp/backup_coordinator are inventoried; dynamic inventory/action outputs, transient logs, generated outputs, and records over 5 MiB are excluded unless explicitly allowlisted. SCIENCE98 accepted plan versions, execution, independent reports, and orchestrator are explicit candidates.",
  "The 100 evidence_files referenced by the frozen physics-core status pins are individually mapped to an exact existing HEAD blob, an exact planned same-path candidate, or a raw-byte snapshot candidate. A missing ref, SHA mismatch, or incomplete mapping blocks later approval.",
  "Mutable or review-pending files require root exact-hash review before any later copy/stage; no acceptance or physics qualification is implied."
 ],
 "no_copy_stage_commit_push_or_persistent_git_config_mutation":True,
 "prep_scope_mutations":["three exact .gitattributes append-only raw-source rules authorized by root; prechange bytes preserved under attribute_snapshots/<repo>/.gitattributes"]
}
manifest={
 "schema":"codex_exact_backup_action_manifest_v2",
 "mode":"PREPARE_ONLY_NOT_AUTHORIZED_FOR_COPY_OR_GIT",
 "inventory_path":str(OUT/"inventory.json"),
