+def _validate_id_roster(value: Any, field: str, gaps: list[dict[str, str]], structural_problems: list[dict[str, str]], *, required: bool) -> tuple[set[str], bool]:
+    """Validate an explicit stable-ID roster without imposing a sample-count target."""
+    if not isinstance(value, list):
+        if required or value is not None:
+            item = {"field": field, "status": "UNKNOWN", "reason": "an explicit ID roster list is missing or malformed"}
+            _gap(gaps, item["field"], item["status"], item["reason"])
+            structural_problems.append(item)
+        return set(), False
+    valid = True
+    ids: set[str] = set()
+    if required and not value:
+        item = {"field": field, "status": "UNKNOWN", "reason": "the required ID roster is explicitly empty"}
+        _gap(gaps, item["field"], item["status"], item["reason"])
+        structural_problems.append(item)
+        valid = False
+    for index, raw_id in enumerate(value):
+        if not isinstance(raw_id, str) or not raw_id or raw_id.strip() != raw_id:
+            item = {"field": f"{field}[{index}]", "status": "UNKNOWN", "reason": "roster entries must be non-empty stable strings without surrounding whitespace"}
+            _gap(gaps, item["field"], item["status"], item["reason"])
+            structural_problems.append(item)
+            valid = False
+            continue
+        if raw_id in ids:
+            item = {"field": f"{field}[{index}]", "status": "FAIL", "reason": f"duplicate ID {raw_id!r} in declared roster"}
+            _gap(gaps, item["field"], item["status"], item["reason"])
+            structural_problems.append(item)
+            valid = False
+            continue
+        ids.add(raw_id)
+    return ids, valid
+
